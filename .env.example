# Terraform Variables - Secret VALUES only
# Non-secret infrastructure inputs live in infra/terraform/terraform.tfvars
export TF_VAR_groq_api_key_value="YOUR_GROQ_API_KEY"
export TF_VAR_jenkins_bitbucket_app_password_value="YOUR_BITBUCKET_APP_PASSWORD"

# Terraform Variables - Secret NAMES (what they'll be called in Secrets Manager)
export TF_VAR_jenkins_bitbucket_app_password_secret_id="digiratina-bitbucket-app-password"
export TF_VAR_groq_api_key_secret_id="digiratina-groq-api-key"

# Optional - Override default S3 bucket name if needed
# export TF_VAR_jenkins_template_s3_bucket="digiratina-api-gw-automation-ap-southeast-1-20260424-9f3c"


